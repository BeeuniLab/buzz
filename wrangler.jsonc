/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
 {
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "buzz",
	"main": "worker/index.ts",
	"compatibility_date": "2025-08-10",
	"compatibility_flags": ["nodejs_compat"],
    "version_metadata": {
        "binding": "CF_VERSION_METADATA"
    },
	"assets": {
		"directory": "dist",
		"not_found_handling": "single-page-application",
		// "run_worker_first": ["!/src/*", "!/api/docs/*"],
        "run_worker_first": true,
        "binding": "ASSETS"
	},
	"observability": {
		"enabled": true,
        "head_sampling_rate": 1,
	},
    "unsafe": {
        "bindings": [
            {
                "name": "API_RATE_LIMITER",
                "type": "ratelimit",
                "namespace_id": "2101",
                "simple": { "limit": 10000, "period": 60 }
            },
            {
                "name": "AUTH_RATE_LIMITER",
                "type": "ratelimit",
                "namespace_id": "2102",
                "simple": { "limit": 1000, "period": 60 }
            }
        ]
    },
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	"ai": {
		"binding": "AI"
	},
    "dispatch_namespaces": [
        {
            "binding": "DISPATCHER",
            "namespace": "buzz-prod-namespace",
            "remote": true
        }
    ],
	"containers": [
		{
			"class_name": "UserAppSandboxService",
			"image": "./SandboxDockerfile",
			"max_instances": 500,
            "instance_type": "standard-2",
            "rollout_step_percentage": 100
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "buzz-db",
			"database_id": "aab712cd-a734-4b37-a54b-acd775716a8a",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "CodeGeneratorAgent",
				"name": "CodeGenObject"
			},
            {
                "class_name": "UserAppSandboxService",
                "name": "Sandbox"
            },
            {
                "class_name": "DORateLimitStore",
                "name": "DORateLimitStore"
            },
            {
                "class_name": "UserSecretsStore",
                "name": "UserSecretsStore"
            }
		]
	},
    "workflows": [
        {
            "binding": "CODE_GENERATION_WORKFLOW",
            "name": "code-generation-workflow",
            "class_name": "CodeGenerationWorkflow"
        }
    ],
    "r2_buckets": [
      {
        "binding": "TEMPLATES_BUCKET",
        "bucket_name": "buzz-templates",
        "preview_bucket_name": "buzz-templates"
      }
    ],
    "kv_namespaces": [
        {
            "binding": "VibecoderStore",
            "id": "be0520bcf9a14a7588d19303c3499d69"
        }
    ],
    // "placement": {
    //   "mode": "smart"
    // },
	"migrations": [
		{
			"new_sqlite_classes": [
				"CodeGeneratorAgent",
				"UserAppSandboxService"
			],
			"tag": "v1"
		},
        {
            "new_sqlite_classes": [
                "DORateLimitStore"
            ],
            "tag": "v2"
        },
        {
            "new_sqlite_classes": [
                "UserSecretsStore"
            ],
            "tag": "v3"
        },
        {
            "deleted_classes": [
                "UserAppSandboxService"
            ],
            "tag": "v4"
        },
        {
            "new_sqlite_classes": [
                "UserAppSandboxService"
            ],
            "tag": "v5"
        }
	],
	"routes": [
        {
            "pattern": "buzzplay.app",
            "custom_domain": true
        },
        {
            "pattern": "*buzzplay.app/*",
            "custom_domain": false,
            "zone_id": "db01fac4261b2604aacad8410443a3e2"
        }
    ],
    "vars": {
        "DISPATCH_NAMESPACE": "buzz-prod-namespace",
        "ENABLE_READ_REPLICAS": "true",
        "CLOUDFLARE_AI_GATEWAY": "buzz-gateway",
        "PLATFORM_CAPABILITIES": {
            "features": {
                "app": {
                    "enabled": true
                },
                "presentation": {
                    "enabled": false
                },
                "general": {
                    "enabled": false
                }
            },
            "version": "1.0.0"
        },
        "CUSTOM_DOMAIN": "buzzplay.app",
        "ALLOCATION_STRATEGY": "one_to_one",
        "MAX_SANDBOX_INSTANCES": "490",
        "SANDBOX_INSTANCE_TYPE": "standard-2",
        "LLM_PROXY_URL": "https://subapi.cygnus.ink/v1",
        "LLM_PROXY_FALLBACK_URL": "https://codex-byering.com:8317/v1",
        "CODE_GENERATION_BACKEND": "native",
        "CODEX_MODEL": "gpt-5.5",
        "CODEX_MODEL_PROVIDER": "crs",
        "CODEX_MODEL_REASONING_EFFORT": "high",
        "INVITE_CODE_REQUIRED": "false",
        "CLERK_JWT_ISSUER": "https://clerk.buzzplay.app",
        "CLERK_JWKS_URL": "https://clerk.buzzplay.app/.well-known/jwks.json"
    },
	"workers_dev": false,
	"preview_urls": false
}
