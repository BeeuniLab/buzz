/**
 * Sources: index.html, src/, lib/, assets/ at package root. Run `npm run build` → dist/ for ASSETS.
 * KV: `npx wrangler kv namespace create BUZZPLAY_HOST` then add
 * kv_namespaces: [{ "binding": "HOST_KV", "id": "...", "preview_id": "..." }].
 * Optional login + cloud sync: `wrangler secret put BUZZPLAY_AUTH_SECRET` (32+ random chars).
 * Subdomains: set var `BUZZPLAY_COOKIE_DOMAIN` to your registrable host e.g. `yoursite.com` so `bp_sess`
 * is shared across `app.*` and `*.game.*`. Use the same secret if the main Buzz app also mints `bp_sess`.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "buzzplay-creative",
	"main": "worker/host.ts",
	"compatibility_date": "2025-04-24",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	}
}
